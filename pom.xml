<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.streamsim</groupId>
    <artifactId>video-stream-simulator</artifactId>
    <version>1.0.0</version>
    <name>Video Stream Simulator</name>
    <description>JavaFX + Spring Boot app that publishes webcam / desktop / file video over RTSP or RTP and receives it</description>

    <properties>
        <java.version>17</java.version>
        <javafx.version>21.0.5</javafx.version>
        <javacv.version>1.5.12</javacv.version>
        <ffmpeg.version>7.1.1-1.5.12</ffmpeg.version>
        <webrtc.version>1.0.1</webrtc.version>
        <start-class>com.streamsim.StreamSimLauncher</start-class>
    </properties>

    <dependencies>
        <!-- Spring Boot core only (no web server needed) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- JavaFX -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- JavaCV: FFmpegFrameGrabber / FFmpegFrameRecorder / JavaFXFrameConverter -->
        <dependency>
            <groupId>org.bytedeco</groupId>
            <artifactId>javacv</artifactId>
            <version>${javacv.version}</version>
        </dependency>
        <!--
            FFmpeg natives. The "-gpl" build contains libx264 (the H.264 encoder used by default).
            To restrict the download to ONE OS, build with e.g.  -Djavacpp.platform=windows-x86_64
            (linux-x86_64, macosx-arm64, macosx-x86_64 ...)
        -->
        <dependency>
            <groupId>org.bytedeco</groupId>
            <artifactId>ffmpeg-platform-gpl</artifactId>
            <version>${ffmpeg.version}</version>
        </dependency>

        <!--
            WebRTC (browser viewing). Pulls the native libwebrtc library for the OS you build on automatically;
            if loading fails add <classifier>windows-x86_64</classifier> (or linux-x86_64, macos-aarch64 ...).
        -->
        <dependency>
            <groupId>dev.onvoid.webrtc</groupId>
            <artifactId>webrtc-java</artifactId>
            <version>${webrtc.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- mvn javafx:run -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>com.streamsim.StreamSimLauncher</mainClass>
                </configuration>
            </plugin>
            <!-- fat jar:  mvn package  ->  java -jar target/video-stream-simulator-1.0.0.jar -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.streamsim.StreamSimLauncher</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
